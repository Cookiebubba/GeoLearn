# Copy to .env (or set these in Railway / your server) — all optional.

# Postgres connection string. Leave unset to use the embedded database
# (PGlite, stored in DATA_DIR) — fine for development and small deployments.
# Railway:  add the Postgres plugin and reference ${{Postgres.DATABASE_URL}}
# Supabase: use the "Session pooler" connection string and set DATABASE_SSL=true
DATABASE_URL=

# Set to true for hosted Postgres that requires TLS (e.g. Supabase).
DATABASE_SSL=false

# Where the embedded database keeps its files when DATABASE_URL is unset.
DATA_DIR=./.data/pglite

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Behind a proxy/load balancer (Railway, nginx, Caddy) keep this on.
TRUST_PROXY=true
